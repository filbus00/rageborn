<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(TF)' == ''">netstandard2.1</TargetFramework><TargetFramework Condition="'$(TF)' != ''">$(TF)</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ARPG.Editor</AssemblyName>
    <DefineConstants>UNITY_EDITOR;UNITY_IOS;DEVELOPMENT_BUILD;UNITY_2023_1_OR_NEWER;UNITY_6000_0_OR_NEWER</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0067;CS0649;CS0169;CS0414;CS0618;CS0108;CS0114</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/_Project/Scripts/Editor/**/*.cs" />
    <ProjectReference Include="../Runtime/Runtime.csproj" />
    <ProjectReference Include="../Stubs/Stubs.csproj" />
  </ItemGroup>
</Project>
